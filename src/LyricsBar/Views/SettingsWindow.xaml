<Window x:Class="LyricsBar.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LyricsBar 设置"
        Width="560"
        Height="720"
        MinWidth="440"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        Background="#F3F3F3"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <!--
      设置窗口走 Win11 的视觉语言：浅色页面 + 圆角卡片分区 + 主题色按钮。
      卡片把"显示 / 排版 / 宽度与位置…"这些彼此无关的分组在视觉上隔开，滚动时一眼能看出选项属于哪一组；
      所有控件模板都是纯 WPF 重画，不引用外部资源，精简版的单文件发布不受影响。
      The settings window follows the Win11 visual language: a light page, rounded section cards, and accent-colored actions.
      Cards keep unrelated groups ("display", "layout", "width & position"…) visually apart so a scroll makes group membership
      obvious. Every control template is a pure WPF redraw referencing no external resources, so the trimmed single-file
      publish is unaffected.
    -->
    <Window.Resources>

        <!-- 全局文字：深灰而不是纯黑，Win11 正文就是这个色；需要换行的说明文字行内显式打开 TextWrapping。 -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1A1A1A" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--
          Win11 单选圈样式的复选框：未选是空心圆（白底细灰边），选中是主题色圆边加中心一个实心点。
          用圆圈是应用户要求：方框对勾在低 DPI 或非整数缩放下，1px 边线被像素对齐切断会呈现"虚线/打勾错误"的观感，
          圆的描边是连续曲线，不会有这种断口。语义仍是复选框（可多选、各选各的），只是换个外形。
          A radio-ring-styled checkbox: a hollow circle when unchecked (white with a hairline grey edge), and an accent ring
          with a solid centre dot when checked. The circle shape is per user request: a square tick box renders its 1px border
          as dashes under low or fractional DPI once pixel snapping cuts the outline, which reads as a broken tick; a circle's
          stroke is one continuous curve with no such gaps. The semantics stay those of a checkbox (independent toggles); only
          the chrome changed.
        -->
        <Style TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,4,0,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!--
                              圈本身不用 SnapsToDevicePixels：像素对齐会把 1px 描边切断成虚线（方框时代的"打勾显示错误"），
                              交给 WPF 抗锯齿过渡，观感才是连续实线。
                              The ring deliberately does not snap to device pixels: pixel alignment is what cut the 1px stroke
                              into dashes in the square-box era, and letting WPF anti-alias the edge keeps it reading as one
                              solid line.
                            -->
                            <Grid x:Name="Chrome" Grid.Column="0" Width="20" Height="20" VerticalAlignment="Center">
                                <Ellipse x:Name="Ring" Fill="#FFFFFF" Stroke="#737373" StrokeThickness="1" />
                                <Ellipse x:Name="Dot" Width="8" Height="8" Fill="#0078D4" Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="#0078D4" />
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="#5C5C5C" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          Win11 下拉框：圆角 4、细边框、右侧chevron（用描边 Path 画，不依赖图标字体）。
          模板里必须保留 PART_EditableTextBox：字体下拉是可编辑的（允许手输字体名），
          ComboBox 自己按这个名字找到文本框并接管显隐与文本同步，缺了它手输功能直接失效。
          还必须保留一个名为 ToggleButton、IsChecked 与 IsDropDownOpen 双向绑定的 ToggleButton：
          WPF 的 ComboBox 自己不处理鼠标左键，展开下拉完全靠模板里的这个按钮切换 IsDropDownOpen。
          之前这份模板漏了它，于是字体 / 对齐方式 / 中文转换 / 停靠位置四个下拉框全都点不开——
          鼠标按下去什么都不会发生，看起来像控件坏了。它铺满整个控件、且要排在最底下：
          上面的 ContentSite 是 IsHitTestVisible=False 的，点击会穿透到它；
          可编辑时的文本框压在它上面，所以在文字区域仍然能点进去打字，点右侧箭头区域才展开。
          Win11 combobox: rounded 4, hairline border, and a chevron on the right drawn as a stroked Path (no icon font).
          The template must keep PART_EditableTextBox: the font list is editable (typed font names are allowed), and ComboBox
          finds the box by that exact name to own its visibility and text sync — without it, typing breaks.
          It must also keep a ToggleButton named ToggleButton whose IsChecked is two-way bound to IsDropDownOpen: WPF's
          ComboBox does not handle the left mouse button itself and opens its dropdown entirely through that button. This
          template used to be missing it, which is why the font / alignment / conversion / docking comboboxes could not be
          opened at all — pressing the mouse did nothing, as if the control were broken. It fills the whole control and sits
          at the bottom of the stack: the ContentSite above it is IsHitTestVisible=False so clicks fall through, while the
          editable text box covers the text area so typing still works and only the chevron area opens the list.
        -->
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="10,0,32,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#8C8C8C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#1A1A1A" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd"
                                    CornerRadius="4"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <!--
                                      展开下拉的唯一入口：铺满整块、透明，与 IsDropDownOpen 双向绑定。
                                      ClickMode=Press 让"按下"即展开，与系统默认下拉框一致。
                                      The only entry point for opening the dropdown: it fills the control, is transparent, and is
                                      two-way bound to IsDropDownOpen. ClickMode=Press opens on mouse-down, matching the stock
                                      combobox.
                                    -->
                                    <ToggleButton x:Name="ToggleButton"
                                                  Focusable="False"
                                                  ClickMode="Press"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <!--
                                      可编辑状态下 ContentSite 与 PART_EditableTextBox 的显隐由代码后置在模板应用后
                                      统一切换（Style 的 Setter 不允许带 TargetName，放不进触发器）。
                                      Which of ContentSite and PART_EditableTextBox shows while editable is switched in the
                                      code-behind once the template is applied: a Style setter cannot carry TargetName, so
                                      a trigger cannot do it.
                                    -->
                                    <ContentPresenter x:Name="ContentSite"
                                                      Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      IsHitTestVisible="False" />
                                    <TextBox x:Name="PART_EditableTextBox"
                                             Visibility="Hidden"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Margin="{TemplateBinding Padding}"
                                             Padding="0"
                                             VerticalContentAlignment="Center"
                                             Foreground="{TemplateBinding Foreground}"
                                             CaretBrush="#1A1A1A"
                                             IsReadOnly="{TemplateBinding IsReadOnly}" />
                                    <!-- 箭头不参与命中测试，否则点在它上面时点击会被它吃掉、传不到下面的 ToggleButton。 -->
                                    <Path HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Margin="0,0,10,0"
                                          IsHitTestVisible="False"
                                          Stroke="#5C5C5C"
                                          StrokeThickness="1.5"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Data="M 0 1.5 L 4 5.5 L 8 1.5" />
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Placement="Bottom"
                                   PopupAnimation="Fade"
                                   StaysOpen="False"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Margin="1">
                                <Border x:Name="DropDown"
                                        CornerRadius="4"
                                        Background="#FFFFFF"
                                        BorderBrush="#D5D5D5"
                                        BorderThickness="1"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer>
                                        <ItemsPresenter x:Name="ItemsPresenter" Margin="0,4" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#5C5C5C" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0078D4" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 下拉条目：悬停浅灰、选中深一档，圆角与下拉框一致。 -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="12,0,12,0" />
            <Setter Property="Height" Value="28" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#1A1A1A" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" CornerRadius="3" Margin="3,0" Background="Transparent" SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EFEFEF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E3E3E3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          Win11 滑块：4px 细轨、主题色已选段、白色圆点滑块。
          PART_Track 这个名字是 Slider 代码查找轨道的约定名，缺了它滑块不能拖动；
          左右 RepeatButton 负责点击轨道跳转与"已播放"填充，命令用 Slider 自带的静态命令。
          Win11 slider: a 4px rail, an accent filled portion, and a white dot thumb. PART_Track is the conventional name
          Slider's code looks up for the track; without it the thumb cannot be dragged. The repeat buttons handle
          click-to-jump and paint the filled portion, routed through Slider's own static commands.
        -->
        <Style TargetType="Slider">
            <Setter Property="Height" Value="24" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="4" CornerRadius="2" Background="#E1E1E1" />
                            <Track x:Name="PART_Track" Margin="8,0">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" VerticalAlignment="Center" CornerRadius="2" Background="#0078D4" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="16" Height="16" Fill="#FFFFFF" Stroke="#737373" StrokeThickness="1" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 常规按钮（次级）：白底细边，悬停浅灰、按下深灰。 -->
        <Style TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="14,0,14,0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#8C8C8C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#1A1A1A" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                CornerRadius="4"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F5F5F5" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E8E8E8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#F3F3F3" />
                                <Setter Property="Foreground" Value="#9A9A9A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主按钮（关闭）：主题色填充白字，只有这一个，页面里只出现一次，不抢次级按钮的戏。 -->
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#0078D4" />
            <Setter Property="BorderBrush" Value="#0078D4" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                CornerRadius="4"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#106EBE" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#005A9E" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#7BAFDC" />
                                <Setter Property="Foreground" Value="#EAF3FB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 单行输入框（颜色值）：圆角细边。PART_ContentHost 是 TextBox 承载光标的约定部件名，必须保留。 -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="8,0,8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#8C8C8C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#1A1A1A" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                CornerRadius="4"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 分区卡片：白底、圆角 8、细边。页底 #F3F3F3 上浮起一层，分组边界一眼可辨。 -->
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18,16,18,16" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="BorderBrush" Value="#E4E4E4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <!-- 卡片内的小标题。 -->
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Foreground" Value="#1A1A1A" />
        </Style>

        <!-- 卡片内的说明文字：小一号、灰一档，允许换行。 -->
        <Style x:Key="CardHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#6B6B6B" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,6" />
        </Style>

        <!-- 设置项左侧的标签列宽，与"排版"网格共用。 -->
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Foreground" Value="#1A1A1A" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 页头：图标 + 标题 + 一句副标题。图标由代码后置从嵌入资源里取，取不到时隐藏。 -->
        <StackPanel Grid.Row="0" Margin="28,22,28,14">
            <Image x:Name="HeaderIcon" Width="26" Height="26" HorizontalAlignment="Left" Margin="0,0,0,10" />
            <TextBlock Text="LyricsBar 设置" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="改动即时生效并自动保存，不需要点「应用」。" FontSize="12" Foreground="#6B6B6B" Margin="0,3,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Padding="28,0,28,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- 显示 -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="显示" Style="{StaticResource CardTitle}" />
                        <CheckBox x:Name="EnabledCheck" Content="在任务栏显示歌词" />
                        <CheckBox x:Name="TwoLineCheck" Content="显示第二行（下一句 / 翻译 / 音译）" />
                        <CheckBox x:Name="TrackInfoBlockCheck" Content="在封面右侧显示曲目信息块（曲名 / 歌手，歌词在它右侧）" />
                        <TextBlock Style="{StaticResource CardHint}"
                                   Text="开着它，曲目信息是封面与歌词之间的独立一块，歌词照旧占两行；关掉则歌词紧贴封面。曲目信息取不到时整块自动收起，不占宽度。" />
                        <CheckBox x:Name="SyllableCheck" Content="逐字擦亮（需要歌词本身带逐字时间轴）" />
                        <CheckBox x:Name="CoverCheck" Content="显示歌曲封面（左侧，来自播放器；无封面时显示首字母色块）" />
                        <CheckBox x:Name="ProgressCheck" Content="显示底部播放进度条" />
                        <CheckBox x:Name="NoLyricsInfoCheck" Content="纯音乐 / 无歌词时把曲名与歌手顶到歌词行（配合封面）" />
                        <TextBlock Style="{StaticResource CardHint}"
                                   Text="纯音乐、伴奏这类没有歌词的曲目：勾选时曲名与歌手占歌词行的位置；取消勾选只是不再占用歌词行，整条栏仍然保留，只剩封面（开了曲目信息块时还有那一块）。" />

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="第二行优先" Style="{StaticResource RowLabel}" />
                            <ComboBox x:Name="SecondaryLineCombo" Grid.Column="1">
                                <ComboBoxItem Content="翻译 → 音译 → 下一句" />
                                <ComboBoxItem Content="音译 → 翻译 → 下一句" />
                                <ComboBoxItem Content="下一句 → 翻译 → 音译" />
                            </ComboBox>
                        </Grid>
                        <TextBlock Style="{StaticResource CardHint}"
                                   Text="双行模式下第二行显示什么：翻译是对当前句的注解，信息量最高；下一句是原文的延续。默认把翻译排在最前。" />
                    </StackPanel>
                </Border>

                <!-- 鼠标操作 -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="鼠标操作" Style="{StaticResource CardTitle}" />
                        <CheckBox x:Name="MouseControlCheck" Content="歌词栏响应鼠标：滚轮切歌、点击栏右侧的按钮切歌与播放 / 暂停" />
                        <TextBlock Style="{StaticResource CardHint}"
                                   Text="开启后歌词栏会接管它覆盖的那一段任务栏上的鼠标事件（那里的图标点击与右键菜单不再落到任务栏）。关掉则恢复点击穿透、纯显示。" />
                    </StackPanel>
                </Border>

                <!-- 排版 -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="排版" Style="{StaticResource CardTitle}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="字体" Style="{StaticResource RowLabel}" />
                            <ComboBox x:Name="FontFamilyCombo"
                                      Grid.Column="1"
                                      IsEditable="True"
                                      ToolTip="可从列表选择，也可以直接输入已安装的字体名" />
                        </Grid>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30" />
                                <RowDefinition Height="30" />
                                <RowDefinition Height="30" />
                                <RowDefinition Height="30" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="字号" Style="{StaticResource RowLabel}" />
                            <Slider x:Name="FontSizeSlider" Grid.Row="0" Grid.Column="1" Minimum="8" Maximum="36" TickFrequency="1" IsSnapToTickEnabled="True" />
                            <TextBlock x:Name="FontSizeText" Grid.Row="0" Grid.Column="2" HorizontalAlignment="Right" Foreground="#6B6B6B" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="字距 %" Style="{StaticResource RowLabel}" />
                            <Slider x:Name="CharSpacingSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="50" TickFrequency="1" IsSnapToTickEnabled="True" />
                            <TextBlock x:Name="CharSpacingText" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Right" Foreground="#6B6B6B" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="行距 %" Style="{StaticResource RowLabel}" />
                            <Slider x:Name="LineGapSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" />
                            <TextBlock x:Name="LineGapText" Grid.Row="2" Grid.Column="2" HorizontalAlignment="Right" Foreground="#6B6B6B" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="未唱不透明度 %" Style="{StaticResource RowLabel}" />
                            <Slider x:Name="UnsungSlider" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" />
                            <TextBlock x:Name="UnsungText" Grid.Row="3" Grid.Column="2" HorizontalAlignment="Right" Foreground="#6B6B6B" />
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="对齐方式" Style="{StaticResource RowLabel}" />
                            <ComboBox x:Name="AlignCombo" Grid.Column="1">
                                <ComboBoxItem Content="居中" />
                                <ComboBoxItem Content="左对齐" />
                                <ComboBoxItem Content="右对齐" />
                                <ComboBoxItem Content="左右分离（主行靠左、第二行靠右）" />
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="中文转换" Style="{StaticResource RowLabel}" />
                            <ComboBox x:Name="ConversionCombo" Grid.Column="1">
                                <ComboBoxItem Content="不转换" />
                                <ComboBoxItem Content="简体 → 繁体" />
                                <ComboBoxItem Content="繁体 → 简体" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 宽度与位置 -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="宽度与位置" Style="{StaticResource CardTitle}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="停靠位置" Style="{StaticResource RowLabel}" />
                            <ComboBox x:Name="BarAlignmentCombo" Grid.Column="1">
                                <ComboBoxItem Content="靠左" />
                                <ComboBoxItem Content="居中" />
                                <ComboBoxItem Content="靠右" />
                            </ComboBox>
                        </Grid>
                        <TextBlock Style="{StaticResource CardHint}"
                                   Text="选好停靠位置后，用下面的偏移量微调：靠左 / 靠右时它是距该侧边缘的距离，居中时它是左右微调量。" />

                        <CheckBox x:Name="FixedWidthCheck" Content="使用固定栏宽" />

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30" />
                                <RowDefinition Height="30" />
                                <RowDefinition Height="30" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="固定宽度 (DIP)" Style="{StaticResource RowLabel}" />
                            <Slider x:Name="FixedWidthSlider" Grid.Row="0" Grid.Column="1" Minimum="120" Maximum="1200" TickFrequency="10" IsSnapToTickEnabled="True" />
                            <TextBlock x:Name="FixedWidthText" Grid.Row="0" Grid.Column="2" HorizontalAlignment="Right" Foreground="#6B6B6B" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="最大宽度 (DIP)" Style="{StaticResource RowLabel}" />
                            <Slider x:Name="MaxWidthSlider" Grid.Row="1" Grid.Column="1" Minimum="120" Maximum="1600" TickFrequency="10" IsSnapToTickEnabled="True" />
                            <TextBlock x:Name="MaxWidthText" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Right" Foreground="#6B6B6B" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="位置偏移 (DIP)" Style="{StaticResource RowLabel}" />
                            <Slider x:Name="OffsetSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="1200" TickFrequency="5" IsSnapToTickEnabled="True" />
                            <TextBlock x:Name="OffsetText" Grid.Row="2" Grid.Column="2" HorizontalAlignment="Right" Foreground="#6B6B6B" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 外观 -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="外观" Style="{StaticResource CardTitle}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="文字颜色" Style="{StaticResource RowLabel}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBox x:Name="ColorBox" Width="150" VerticalContentAlignment="Center" ToolTip="#RRGGBB 或颜色名，如 White、#FFE082" />
                                <Border x:Name="ColorPreview" Width="30" Height="22" Margin="10,0,0,0" BorderBrush="#8C8C8C" BorderThickness="1" CornerRadius="3" />
                            </StackPanel>
                        </Grid>
                        <CheckBox x:Name="ShadowCheck" Content="文字加对比阴影（深色壁纸下更清晰）" />
                    </StackPanel>
                </Border>

                <!-- 歌词来源 -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="歌词来源" Style="{StaticResource CardTitle}" />
                        <TextBlock Style="{StaticResource CardHint}" Text="不勾选任何来源 = 不联网取词。" />
                        <StackPanel x:Name="SourcePanel" />

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="匹配严格度" Style="{StaticResource RowLabel}" />
                            <ComboBox x:Name="MatchStrictnessCombo" Grid.Column="1">
                                <ComboBoxItem Content="宽松（优先有词，允许曲名/歌手差异较大）" />
                                <ComboBoxItem Content="适中（默认，允许轻微差异）" />
                                <ComboBoxItem Content="严格（要求曲名与歌手高度吻合）" />
                            </ComboBox>
                        </Grid>
                        <TextBlock Style="{StaticResource CardHint}"
                                   Text="宽松模式下哪怕曲名或歌手对不上也容易取到词；严格模式只收高度吻合的结果。网易云用户建议选「适中」或「严格」，因为程序会尝试从网易云本地队列读到精确歌曲 ID。" />
                    </StackPanel>
                </Border>

                <!-- 其它 -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="其它" Style="{StaticResource CardTitle}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="歌词渲染" Style="{StaticResource RowLabel}" />
                            <ComboBox x:Name="RendererCombo" Grid.Column="1">
                                <ComboBoxItem Content="原生（推荐，只有一个进程）" />
                                <ComboBoxItem Content="网页（WebView2，兼容旧观感）" />
                            </ComboBox>
                        </Grid>
                        <TextBlock Style="{StaticResource CardHint}"
                                   Text="原生由程序自己绘制歌词，不起浏览器子进程，内存占用最低；网页版会额外拉起一整套 msedgewebview2 进程，仅作对拍与兜底。改动会在重新停靠后生效。" />

                        <CheckBox x:Name="SoftwareRenderCheck" Content="强制软件渲染（仅网页引擎：GPU 进程崩溃时勾选）" />
                        <CheckBox x:Name="CompatibilityModeCheck" Content="兼容模式：同时关闭沙箱（仅网页引擎：歌词栏一片空白时勾选）" />
                        <TextBlock Style="{StaticResource CardHint}"
                                   Text="这两项只影响网页引擎的渲染方式，不影响取词，原生引擎下无作用。受限环境下先试兼容模式。" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button x:Name="RedockButton" Content="重新停靠到任务栏" />
                            <Button x:Name="OpenFolderButton" Content="打开设置文件夹" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="StatusText" Margin="0,10,0,0" Foreground="#6B6B6B" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 页脚：恢复默认靠左，关闭（主按钮）靠右。 -->
        <Border Grid.Row="2" Padding="28,10,28,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="ResetButton" Grid.Column="0" Content="恢复默认" HorizontalAlignment="Left" />
                <Button x:Name="CloseButton" Grid.Column="1" Content="关闭" Style="{StaticResource AccentButton}" Padding="22,0,22,0" IsDefault="True" />
            </Grid>
        </Border>
    </Grid>
</Window>
